# Server-side API keys for managed models (see server/config/serverModels.json).
# These never reach the browser: the server proxies requests and injects the key.
# Copy this file to .env and fill in the keys for the upstreams you use.

OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional: override the server port (default 3000)
# PORT=3000

# Optional: log verbosity — debug | info | warn | error (default info)
# LOG_LEVEL=debug
